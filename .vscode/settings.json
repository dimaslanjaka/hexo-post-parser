{
  "terminal.integrated.env.linux": {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/usr/lib/wsl/lib:${workspaceFolder}/bin:${workspaceFolder}/node_modules/.bin:${workspaceFolder}/vendor/bin",
    "NUITKA_CACHE_DIR": "${workspaceFolder}\\tmp\\nuitka-cache",
    "ESLINT_USE_FLAT_CONFIG": "true",
    "DEBUG_PKG": "1",
    "PUPPETEER_SKIP_DOWNLOAD": "true",
    "PHP_CS_FIXER_IGNORE_ENV": "1"
  },
  "terminal.integrated.env.windows": {
    "PATH": "${env:LOCALAPPDATA}\\nvm;C:\\nvm4w\\nodejs;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\usr\\bin;${env:PATH};${workspaceFolder}\\node_modules\\.bin;${workspaceFolder}\\bin;${workspaceFolder}\\vendor\\bin;C:\\laragon\\bin\\mysql\\mysql-8.4.3-winx64\\bin;${env:LOCALAPPDATA}\\Programs\\Ollama",
    "NUITKA_CACHE_DIR": "${workspaceFolder}\\tmp\\nuitka-cache",
    "ESLINT_USE_FLAT_CONFIG": "true",
    "DEBUG_PKG": "1",
    "PUPPETEER_SKIP_DOWNLOAD": "true",
    "PHP_CS_FIXER_IGNORE_ENV": "1",
    "WORKSPACE_FOLDER": "${workspaceFolder}"
  },
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash"
    },
    "Cygwin": {
      "path": "C:\\cygwin64\\bin\\bash.exe",
      "args": ["--login", "-i"],
      "env": {
        "CHERE_INVOKING": "1"
      }
    },
    "Short PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "function prompt { \"[$((Get-Item .).Name)]> \" }"
      ],
      "icon": "terminal-powershell"
    },
    "Short Command Prompt": {
      "path": ["${env:windir}\\System32\\cmd.exe"],
      "args": ["/k", "prompt $p$_$g"],
      "icon": "terminal-cmd"
    },
    "PowerShell 7": {
      "path": "${env:LOCALAPPDATA}\\Microsoft\\WindowsApps\\pwsh.exe",
      "icon": "terminal-powershell"
    },
    "Short PowerShell 7": {
      "path": "${env:LOCALAPPDATA}\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoExit",
        "-Command",
        "function prompt { Write-Host '[' -NoNewline -ForegroundColor DarkGray; Write-Host (Split-Path -Leaf (Get-Location)) -NoNewline -ForegroundColor Cyan; Write-Host ']> ' -NoNewline -ForegroundColor DarkGray; return ' ' }"
      ],
      "icon": "terminal-powershell"
    },
    "Oh My Posh": {
      "path": "${env:LOCALAPPDATA}\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoExit",
        "-Command",
        "$candidates = @('${workspaceFolder}/scripts/OhMyPoshInit.ps1','${workspaceFolder}/node_modules/@dimaslanjaka/eslint-base-config/scripts/OhMyPoshInit.ps1'); $init = $candidates | Where-Object { Test-Path $_ } | Select-Object -First 1; if ($init) { if ((Get-ExecutionPolicy -Scope CurrentUser) -eq 'Restricted') { Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned -Force }; & $init } else { oh-my-posh init pwsh | Invoke-Expression }"
      ],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.fontFamily": "MesloLGM Nerd Font",
  "terminal.integrated.defaultProfile.windows": "Oh My Posh",
  "files.autoSave": "onWindowChange",
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.organizeImports": "never",
    "source.fixAll.eslint": "explicit",
    "source.fixAll.ts": "never",
    "source.addMissingImports.ts": "never",
    "source.removeUnused.ts": "never",
    "source.removeUnusedImports": "never",
    "source.sort.json": "never",
    "source.sortImports": "never"
  },
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "code-runner.clearPreviousOutput": true,
  "code-runner.ignoreSelection": true,
  "code-runner.runInTerminal": true,
  "code-runner.saveAllFilesBeforeRun": true,
  "code-runner.executorMapByGlob": {
    "*.{test,spec}.ts": "npm test -- $fileNameWithoutExt",
    "*.{test,spec}.{js,cjs,mjs}": "npm test -- $fileNameWithoutExt",
    "electron-*.ts": "cross-env-shell NODE_ENV=development electron -r ts-node/register",
    "*.py": "python -u",
    "*.electron.js": "cross-env-shell NODE_ENV=development electron -r ts-node/register",
    "*.runner.{cjs,js,mjs}": "npm run build && node --no-warnings --experimental-specifier-resolution=node",
    "*.runner.ts": "node --no-warnings --experimental-specifier-resolution=node --loader ts-node/esm -r dotenv/config",
    "*.ts": "node --no-warnings --experimental-specifier-resolution=node --loader ts-node/esm -r dotenv/config"
  },
  "code-runner.respectShebang": true,
  "debug.terminal.clearBeforeReusing": true,
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    },
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[json]": {
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    }
  },
  "[jsonc]": {
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    }
  },
  "[html]": {
    "editor.suggest.insertMode": "replace",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    }
  },
  "[njk]": {
    "editor.suggest.insertMode": "replace",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    }
  },
  "autopep8.args": ["--ignore", "E401,E402,E211,E501"],
  "intelephense.maxMemory": 1028,
  "intelephense.rename.exclude": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/tmp/**",
    "**/dist/**",
    "**/.cache/**"
  ],
  "intelephense.references.exclude": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/tmp/**",
    "**/dist/**",
    "**/.cache/**"
  ],
  "intelephense.trace.server": "messages",
  "intelephense.completion.maxItems": 100,
  "intelephense.diagnostics.run": "onSave",
  "intelephense.files.exclude": [
    "**/.DS_Store/**",
    "**/.cache/**",
    "**/.git/**",
    "**/.hg/**",
    "**/.history/**",
    "**/.idea/**",
    "**/.svn/**",
    "**/.yarn/**",
    "**/CVS/**",
    "**/Thumbs.db",
    "**/assets/**/*",
    "**/bower_components/**",
    "**/config/**/*",
    "**/dist/**",
    "**/node_modules/**",
    "**/tmp/**",
    "**/.venv/**",
    "**/venv/**",
    "**/assets/**",
    "**/*.sqlite"
  ],
  "intelephense.files.associations": ["*.php", "*.phtml"],
  "intelephense.telemetry.enabled": true,
  "eslint.debug": true,
  "eslint.useFlatConfig": true,
  "python.createEnvironment.contentButton": "show",
  "python.terminal.activateEnvInCurrentTerminal": true,
  "files.watcherExclude": {
    "**/.cache/**": true,
    "**/.idea/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/profiles/**": true,
    "**/config/**": true,
    "**/databases/**": true,
    "**/node_modules/**": true,
    "src/database.sqlite*": true
  },
  "intelephense.environment.documentRoot": "${workspaceFolder}",
  "intelephense.environment.includePaths": [
    "${workspaceFolder}/src",
    "${workspaceFolder}/vendor"
  ],
  "files.exclude": {
    "*.php": true,
    "**/.cache/**": true,
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.idea/**": true,
    "**/.svn": true,
    "**/.venv": true,
    "**/config": true,
    "**/CVS": true,
    "**/node_modules": true,
    "**/Thumbs.db": true,
    "**/vendor": true,
    "**/venv": true,
    "backups": true,
    "data/engine": true,
    "data/fingerprints": true,
    "data/profiles": true,
    "data/run": true
  },
  "files.readonlyInclude": {
    "**/*.sqlite*": true
  },
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": false,
  "eslint.probe": [
    "astro",
    "civet",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "mdx",
    "vue",
    "markdown",
    "json",
    "jsonc",
    "css",
    "glimmer-js",
    "glimmer-ts",
    "svelte",
    "nunjucks"
  ],
  "eslint.validate": [
    "astro",
    "civet",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "mdx",
    "vue",
    "markdown",
    "json",
    "jsonc",
    "css",
    "glimmer-js",
    "glimmer-ts",
    "svelte",
    "nunjucks"
  ],
  "git.autoStash": true,
  "git.useCommitInputAsStashMessage": true
}
